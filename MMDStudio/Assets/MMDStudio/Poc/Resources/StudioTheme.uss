/* Easy Dance Studio — light, minimal workspace theme (MVP-08).
   Palette: surface #FFFFFF, canvas #F4F4F5, border #E4E4E7, text #18181B,
   muted #71717A, accent #2563EB. Applied on top of the runtime theme. */

.eds-root { color: #18181B; font-size: 13px; }
.eds-muted { color: #71717A; }

/* ---------- Top bar ---------- */
.eds-topbar { position: absolute; top: 12px; left: 12px; right: 12px; height: 52px; flex-direction: row; align-items: center; padding-left: 20px; padding-right: 14px;
    background-color: #FFFFFF; border-width: 1px; border-color: #E4E4E7; border-radius: 12px; }
.eds-app-title { font-size: 16px; -unity-font-style: bold; color: #18181B; margin-right: 12px; }
.eds-project-name { color: #71717A; font-size: 12px; max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.eds-spacer { flex-grow: 1; }
.eds-divider-v { width: 1px; height: 20px; background-color: #E4E4E7; margin-left: 6px; margin-right: 6px; }

/* ---------- Buttons ---------- */
.eds-button { height: 30px; margin: 0 6px 0 0; padding: 0 12px; border-width: 1px; border-radius: 7px; border-color: #E4E4E7;
    background-color: #FFFFFF; color: #18181B; -unity-text-align: middle-center; font-size: 12px; }
.eds-button:hover { background-color: #F4F4F5; }
.eds-button:active { background-color: #E4E4E7; }
.eds-button:disabled { opacity: 0.45; }
.eds-button--primary { background-color: #2563EB; border-color: #2563EB; color: #FFFFFF; }
.eds-button--primary:hover { background-color: #1D4ED8; border-color: #1D4ED8; }
.eds-button--danger { color: #DC2626; }
.eds-button--danger-fill { background-color: #DC2626; border-color: #DC2626; color: #FFFFFF; }
.eds-button--danger-fill:hover { background-color: #B91C1C; border-color: #B91C1C; }
.eds-button--block { flex-grow: 1; margin-right: 0; }
.eds-icon-button { width: 34px; height: 34px; padding: 0; margin: 0 2px; border-width: 0; border-radius: 8px;
    background-color: rgba(0, 0, 0, 0); align-items: center; justify-content: center; }
.eds-icon-button:hover { background-color: #F4F4F5; }
.eds-icon-button:active { background-color: #E4E4E7; }
.eds-icon-button:disabled { opacity: 0.35; }
.eds-icon-button:focus { background-color: rgba(0, 0, 0, 0); }
.eds-icon-button:focus:hover { background-color: #F4F4F5; }

/* ---------- Body / panels ---------- */
.eds-body { position: absolute; left: 0; right: 0; top: 0; bottom: 0; min-height: 0; }
.eds-explorer { position: absolute; top: 76px; bottom: 94px; left: 12px; width: 236px; padding: 16px 12px 12px 16px;
    background-color: #FFFFFF; border-width: 1px; border-color: #E4E4E7; border-radius: 12px; }
.eds-inspector { position: absolute; top: 76px; bottom: 94px; right: 12px; width: 300px; padding: 16px 12px 8px 18px;
    background-color: #FFFFFF; border-width: 1px; border-color: #E4E4E7; border-radius: 12px; }
.eds-panel-title { font-size: 12px; -unity-font-style: bold; color: #18181B; margin-bottom: 10px; }
.eds-card-header { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 10px; }
.eds-card-header .eds-panel-title { margin-bottom: 0; }
.eds-card-hide { width: 24px; height: 24px; min-width: 24px; padding: 0; margin: 0 0 0 8px;
    border-width: 0; background-color: rgba(0, 0, 0, 0); color: #71717A; font-size: 17px; }
.eds-card-hide:hover { background-color: #F4F4F5; color: #18181B; }

/* Explorer tree */
.eds-tree-root { flex-direction: row; align-items: center; height: 26px; color: #71717A; font-size: 12px; }
.eds-tree-group { font-size: 11px; color: #A1A1AA; margin: 8px 0 2px 22px; }
.eds-row { height: 28px; margin: 1px 0; padding: 0 8px 0 22px; border-width: 0; border-radius: 6px; background-color: rgba(0, 0, 0, 0);
    flex-direction: row; align-items: center; -unity-text-align: middle-left; color: #18181B; font-size: 13px; }
.eds-row:hover { background-color: #F4F4F5; }
.eds-row--selected { background-color: #EFF4FF; color: #1D4ED8; }
.eds-row--selected:hover { background-color: #E5EDFF; }
.eds-row--hidden { color: #A1A1AA; }
.eds-row--missing { color: #B45309; }
.eds-row--missing.eds-row--selected { background-color: #FEF3C7; color: #92400E; }
.eds-row-icon { position: absolute; left: 4px; top: 6px; }
.eds-row:focus { background-color: rgba(0, 0, 0, 0); }
.eds-row--selected:focus { background-color: #EFF4FF; }
.eds-explorer-actions { flex-direction: row; padding-top: 10px; border-top-width: 1px; border-color: #EEEEF0; }

/* The camera always fills the client area. UI sits on top of this transparent layer. */
.eds-viewport-wrap { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.eds-viewport { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.eds-viewport-hint { position: absolute; left: 260px; bottom: 100px; font-size: 11px; color: #52525B; }
.eds-empty { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; }
.eds-empty-title { font-size: 15px; color: #3F3F46; margin-top: 12px; }
.eds-empty-sub { font-size: 13px; color: #71717A; margin-top: 4px; }

/* Inspector sections */
.eds-selection-title { font-size: 14px; -unity-font-style: bold; color: #18181B; }
.eds-selection-info { font-size: 12px; color: #71717A; margin-top: 2px; margin-bottom: 4px; white-space: normal; }
.eds-section { border-top-width: 1px; border-color: #EEEEF0; padding-top: 12px; padding-bottom: 12px; margin-right: 6px; }
.eds-section-title { font-size: 12px; -unity-font-style: bold; color: #3F3F46; margin-bottom: 8px; }
.eds-section-text { font-size: 12px; color: #52525B; white-space: normal; margin-bottom: 6px; }
.eds-row-buttons { flex-direction: row; margin-top: 6px; }
.eds-note { font-size: 11px; color: #A1A1AA; white-space: normal; margin-top: 4px; }

/* ---------- Fields ---------- */
.unity-base-field { margin-left: 0; margin-right: 0; }
.unity-base-field__label { color: #52525B; font-size: 12px; min-width: 64px; }
.unity-base-text-field__input { background-color: #FFFFFF; border-width: 1px; border-color: #E4E4E7; border-radius: 6px; color: #18181B;
    padding: 0 6px; margin: 0; height: 26px; font-size: 12px; -unity-text-align: middle-left; }
.unity-base-text-field__input .unity-text-element { padding: 0; margin: 0; font-size: 12px; color: #18181B; -unity-text-align: middle-left; }
.unity-base-text-field:focus > .unity-base-text-field__input { border-color: #2563EB; }
.unity-base-popup-field__input { background-color: #FFFFFF; border-width: 1px; border-color: #E4E4E7; border-radius: 6px; color: #18181B; height: 26px; padding: 0 8px; margin: 0; }
.unity-base-popup-field__text { color: #18181B; font-size: 12px; padding: 0; margin: 0; -unity-text-align: middle-left; }
.unity-base-popup-field__arrow { -unity-background-image-tint-color: #71717A; }
.eds-vector { margin-bottom: 8px; flex-direction: column; }
.eds-vector > .unity-base-field__label { margin-bottom: 4px; }
.eds-vector .unity-composite-field__input { flex-direction: row; }
.eds-vector .unity-float-field { width: 82px; min-width: 0; flex-shrink: 0; margin-right: 4px; flex-direction: row; align-items: center; }
.eds-vector .unity-float-field > .unity-base-field__label { min-width: 12px; width: 12px; color: #A1A1AA; font-size: 11px; padding: 0; margin-right: 2px; }
.eds-vector .unity-base-text-field__input { min-width: 40px; flex-grow: 1; height: 26px; }

/* Horizontal sliders (scrollbars are vertical and styled separately) */
.unity-base-slider--horizontal .unity-base-slider__tracker { background-color: #E4E4E7; border-width: 0; height: 4px; margin-top: -2px; border-radius: 2px; }
.unity-base-slider--horizontal .unity-base-slider__dragger { background-color: #FFFFFF; border-color: #2563EB; border-width: 2px;
    width: 14px; height: 14px; border-radius: 7px; margin-top: -7px; }
.unity-base-slider--horizontal .unity-base-slider__dragger-border { display: none; }
.unity-base-slider--horizontal .unity-base-text-field__input { height: 24px; }
.eds-graphics-slider { margin-bottom: 4px; }
.eds-graphics-slider .unity-base-text-field { width: 50px; margin-left: 8px; }

/* Toggles */
.unity-toggle__checkmark { background-color: #FFFFFF; border-color: #D4D4D8; border-width: 1px; border-radius: 4px; width: 16px; height: 16px; }
.unity-toggle:checked .unity-toggle__checkmark { background-color: #2563EB; border-color: #2563EB; -unity-background-image-tint-color: #FFFFFF; }

/* Scrollbars: thin, no arrows */
.unity-scroller--vertical { width: 8px; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.unity-scroller--vertical .unity-scroller__low-button, .unity-scroller--vertical .unity-scroller__high-button { display: none; }
.unity-scroller--vertical .unity-base-slider__tracker { background-color: rgba(0, 0, 0, 0); border-width: 0; }
.unity-scroller--vertical .unity-base-slider__dragger { background-color: #D4D4D8; border-width: 0; border-radius: 4px; width: 6px; margin-left: 1px; }
.unity-scroller--vertical .unity-base-slider__dragger-border { display: none; }
.unity-scroller--horizontal { display: none; }

/* ---------- Gizmo mode bar (viewport top-left) ---------- */
.eds-gizmo-bar { position: absolute; left: 260px; top: 76px; flex-direction: row; background-color: #FFFFFF; border-radius: 8px;
    border-width: 1px; border-color: #E4E4E7; padding: 2px; }
.eds-gizmo-button { height: 26px; margin: 0; padding: 0 10px; border-width: 0; border-radius: 6px; background-color: rgba(0, 0, 0, 0);
    color: #52525B; font-size: 12px; }
.eds-gizmo-button:hover { background-color: #F4F4F5; }
.eds-gizmo-button:focus { background-color: rgba(0, 0, 0, 0); }
.eds-gizmo-button--active, .eds-gizmo-button--active:focus { background-color: #EFF4FF; color: #1D4ED8; }
.eds-gizmo-button:disabled { opacity: 0.4; }
.eds-gizmo-bar .eds-card-hide { height: 26px; }

/* ---------- Playback bar ---------- */
.eds-playback { position: absolute; left: 12px; right: 12px; bottom: 40px; height: 50px; flex-direction: row; align-items: center;
    padding-left: 16px; padding-right: 20px; background-color: #FFFFFF; border-width: 1px; border-color: #E4E4E7; border-radius: 12px; }
.eds-timeline { flex-grow: 1; margin-left: 12px; margin-right: 14px; }
.eds-time { color: #52525B; font-size: 12px; min-width: 116px; -unity-text-align: middle-right; }
.eds-playback-options { flex-direction: row; align-items: center; margin-left: 14px; }
.eds-loop .unity-base-field__label { min-width: 0; margin-right: 4px; }
.eds-speed { width: 150px; height: 24px; margin-left: 12px; align-items: center; }
.eds-speed .unity-base-slider__input { height: 24px; }
.eds-speed > .unity-base-field__label { min-width: 34px; }
.eds-speed-value { color: #52525B; font-size: 12px; width: 36px; -unity-text-align: middle-right; }

/* ---------- Status bar ---------- */
.eds-statusbar { position: absolute; left: 12px; right: 12px; bottom: 8px; height: 28px; flex-direction: row; align-items: center;
    padding-left: 20px; padding-right: 20px; background-color: #FFFFFF; border-width: 1px; border-color: #E4E4E7; border-radius: 8px; }
.eds-status { flex-grow: 1; color: #71717A; font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.eds-status--error { color: #DC2626; }
.eds-chip { font-size: 11px; color: #71717A; background-color: #F4F4F5; border-radius: 10px; padding: 2px 8px; margin-left: 8px; }
.eds-statusbar .eds-card-hide { height: 20px; min-width: 20px; width: 20px; font-size: 15px; }

/* View controls float above the scene and disappear in focus view. */
.eds-view-menu { position: absolute; top: 70px; right: 12px; width: 190px; padding: 8px; background-color: #FFFFFF;
    border-width: 1px; border-color: #E4E4E7; border-radius: 10px; }
.eds-view-menu-row { width: 172px; margin: 2px 0; -unity-text-align: middle-left; }
.eds-collapsed-tab { position: absolute; height: 30px; padding: 0 10px; margin: 0; background-color: rgba(255, 255, 255, 0.9);
    border-color: #D4D4D8; border-radius: 8px; color: #52525B; font-size: 11px; }
.eds-collapsed-tab--explorer { left: 12px; top: 76px; }
.eds-collapsed-tab--inspector { right: 12px; top: 76px; }
.eds-collapsed-tab--playback { left: 12px; bottom: 40px; }
.eds-collapsed-tab--status { left: 12px; bottom: 8px; height: 28px; }
.eds-collapsed-tab--gizmo { top: 76px; }
.eds-restore-controls { position: absolute; top: 12px; right: 12px; width: 104px; height: 28px; padding: 0; margin: 0;
    background-color: rgba(255, 255, 255, 0.9); border-color: #D4D4D8; border-radius: 8px; color: #3F3F46; font-size: 11px; }
.eds-focus-notice { position: absolute; left: 12px; bottom: 12px; max-width: 70%; padding: 8px 12px;
    background-color: rgba(255, 255, 255, 0.85); border-radius: 8px; color: #3F3F46; font-size: 12px; white-space: normal; }
.eds-loading-card { position: absolute; left: 12px; bottom: 100px; min-width: 290px; max-width: 460px; height: 42px;
    flex-direction: row; align-items: center; padding: 5px 7px 5px 12px; background-color: rgba(255, 255, 255, 0.95);
    border-width: 1px; border-color: #D4D4D8; border-radius: 9px; }
.eds-loading-label { flex-grow: 1; font-size: 12px; color: #3F3F46; white-space: normal; }
.eds-loading-card .eds-button { margin: 0 0 0 8px; }

/* ---------- Dialogs ---------- */
.eds-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(24, 24, 27, 0.28); align-items: center; justify-content: center; }
.eds-dialog { width: 420px; background-color: #FFFFFF; border-radius: 12px; border-width: 1px; border-color: #E4E4E7; padding: 20px 20px 16px 20px; }
.eds-dialog-text { white-space: normal; color: #18181B; font-size: 13px; margin-bottom: 16px; }
.eds-dialog-buttons { flex-direction: row; justify-content: flex-end; }
.eds-dialog-content { margin: -6px 0 14px 0; }
.eds-dialog--wide { width: 680px; }
.eds-diagnostics-scroll { height: 360px; border-width: 1px; border-color: #E4E4E7; border-radius: 6px; }
.eds-diagnostics { margin: 0; padding: 8px 10px; font-size: 11px; white-space: normal; color: #27272A; background-color: #FAFAFA; }
.eds-recent-row { flex-direction: row; align-items: center; margin: 1px 0; }
.eds-recent-open { flex-grow: 1; flex-shrink: 1; height: 40px; margin: 0; padding: 3px 8px; border-width: 0; border-radius: 6px; background-color: rgba(0, 0, 0, 0);
    -unity-text-align: upper-left; color: #18181B; font-size: 13px; overflow: hidden; }
.eds-recent-open:hover { background-color: #F4F4F5; }
.eds-recent-open--missing { color: #B45309; }
.eds-recent-folder { position: absolute; left: 8px; right: 8px; bottom: 3px; font-size: 11px; color: #71717A; overflow: hidden; text-overflow: ellipsis; }
.eds-recent-remove { width: 28px; height: 28px; margin: 0 0 0 4px; padding: 0; border-width: 0; border-radius: 6px; background-color: rgba(0, 0, 0, 0);
    color: #71717A; font-size: 15px; }
.eds-recent-remove:hover { background-color: #F4F4F5; color: #18181B; }
